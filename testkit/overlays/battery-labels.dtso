/dts-v1/;
/plugin/;
/*
 * iPhone 6s battery fuel gauge, live-test overlay for a base DT that has
 * __symbols__ and the serial1..6 nodes (foundation kernel).
 * Build: dtc -@ -I dts -O dtb -o battery-labels.dtbo battery-labels.dtso
 * Apply once per boot; do not remove it while samsung-uart is bound.
 */
&pinctrl_ap {
	/* uart5 TX = pin 2, RX = pin 3 (iBoot leaves RX as a GPIO) */
	hdq_uart5_pins: hdq-uart5-pins {
		pinmux = <0x10002>, <0x10003>;	/* APPLE_PINMUX(2,1), (3,1) */
	};
};

&i2c1 {
	status = "okay";

	hdq_charger: charger@75 {
		compatible = "ti,sn2400";
		reg = <0x75>;
		#mux-state-cells = <1>;
	};
};

&serial5 {
	pinctrl-0 = <&hdq_uart5_pins>;
	pinctrl-names = "default";
	status = "okay";

	fuel-gauge {
		compatible = "ti,bq27540-hdq";
		mux-states = <&hdq_charger 1>;	/* line connected to the host */
	};
};
