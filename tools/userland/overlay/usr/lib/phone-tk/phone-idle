#!/bin/sh
# hypridle launcher for the Omarchy Phone session: system-side idle power
# management (DPMS + the apple-dwi-bl backlight). Started from hyprland.lua's
# hyprland.start hook (both the phone shell and the plain session), so it
# inherits WAYLAND_DISPLAY / HYPRLAND_INSTANCE_SIGNATURE the same way qs and
# foot do -- no separate systemd unit has to rediscover them.
#
# Interaction with the phone shell (docs/userland.md "Idle and lock (system
# side)"): the shell already runs its own ext-idle-notify-v1 client
# (Quickshell's IdleMonitor, shell/qs/Services/Phone.qml) that locks and
# DPMS-disables at OPHONE_IDLE_SECONDS (default 180s, shell/qs/Services/
# Config.qml). ext-idle-notify-v1 lets any number of clients register
# independent idle timeouts against the same compositor, so this hypridle is
# a second, independent consumer of the same protocol -- it does not race or
# "win" against the shell's timer, and the shell doesn't know it exists.
# hypridle's own job is what the shell doesn't do: drop the backlight to 0
# (the real ~80 mA save -- DPMS alone may not touch backlight power on
# simpledrm, which has no real panel driver) and give the plain (foot-only)
# fallback session, which has no idle handling of its own, a DPMS-off too.
#
# See idle-screen-on for the other half of the interaction (the shell turns
# off automatic DPMS-wake-on-input; hypridle must not undo that).
set -eu

PHONE_TK=/usr/lib/phone-tk
pgrep -u "$(id -u)" -x hypridle >/dev/null 2>&1 && exit 0   # already running (session restart)

# Configurable timeouts (docs/userland.md "Idle and lock (system side)"):
# /etc/omarchy-phone/idle.conf (shell-sourceable KEY=VALUE) is the
# persistent, per-phone way to set these; env vars are for a one-off
# override (e.g. over ssh: PHONE_IDLE_SECONDS=20 phone-idle).
CONF=/etc/omarchy-phone/idle.conf
[ -r "$CONF" ] && . "$CONF"
# PHONE_IDLE_SECONDS falls back to the shell's own OPHONE_IDLE_SECONDS (if
# that's set in the session environment) so one knob can drive both; then a
# built-in default matching Config.qml's idleLockSeconds. If you diverge the
# two on purpose, keep this one >= the shell's, so the panel doesn't go dark
# a few seconds before the shell's own lock screen has painted.
PHONE_IDLE_SECONDS="${PHONE_IDLE_SECONDS:-${OPHONE_IDLE_SECONDS:-180}}"
# Short listener: catches a manual power-key lock, which DPMS-disables
# immediately and isn't itself "idle" -- see idle-screen-off.
PHONE_IDLE_LOCK_DETECT_SECONDS="${PHONE_IDLE_LOCK_DETECT_SECONDS:-5}"

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"
CFG="$XDG_RUNTIME_DIR/phone-idle-hypridle.conf"
cat > "$CFG" <<EOF
# Generated by $PHONE_TK/phone-idle at session start -- do not edit by hand.
# Change /etc/omarchy-phone/idle.conf (or the env vars) and restart the
# session (systemctl --user restart omarchy-phone-session), which re-runs
# this generator.
listener {
    timeout = $PHONE_IDLE_SECONDS
    on-timeout = $PHONE_TK/idle-screen-off always
    on-resume = $PHONE_TK/idle-screen-on
}
listener {
    timeout = $PHONE_IDLE_LOCK_DETECT_SECONDS
    on-timeout = $PHONE_TK/idle-screen-off if-dpms-off
    on-resume = $PHONE_TK/idle-screen-on
}
EOF

exec hypridle -c "$CFG"
