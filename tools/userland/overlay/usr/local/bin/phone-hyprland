#!/bin/sh
# Start Hyprland on the framebuffer. seatd hands out the seat, so no VT login
# is needed. At boot the omarchy-phone-session user unit runs this with --fg;
# by hand (with that unit disabled or stopped):
#   ssh omarchy@172.16.42.1 phone-hyprland        (log: ~/.cache/hyprland.log)
#   ssh omarchy@172.16.42.1 pkill -x Hyprland     (stop)
#   systemctl --user restart omarchy-phone-session   (restart the boot session)
# ~/.config/hypr/hyprland.lua starts the Omarchy Phone shell (QuickShell) with
# the iphone6s device profile; PHONE_PLAIN=1 starts the plain foot session.
set -eu
if pgrep -u "$(id -u)" -x Hyprland >/dev/null 2>&1; then
	echo "Hyprland is already running (the boot session is omarchy-phone-session.service:" >&2
	echo "  systemctl --user restart omarchy-phone-session, or stop it first)" >&2
	exit 1
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-seatd}"
# simpledrm is KMS-only (no render node). GBM_ALWAYS_SOFTWARE makes Mesa's GBM
# take its software path (kms_swrast + llvmpipe, dumb buffers on card0), and
# EGL on GBM then renders with it. Do NOT set MESA_LOADER_DRIVER_OVERRIDE=
# kms_swrast: that loads kms_swrast as a "hardware" driver, EGL then looks for
# a render node to pair with card0 and eglInitialize fails with "DRI2: failed
# to get compatible render device" (Hyprland aborts in CHyprOpenGLImpl::initEGL).
unset MESA_LOADER_DRIVER_OVERRIDE
export AQ_DRM_DEVICES="${AQ_DRM_DEVICES:-/dev/dri/card0}"
export GBM_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"
export LIBGL_ALWAYS_SOFTWARE=1
export AQ_NO_MODIFIERS=1
export XDG_SESSION_TYPE=wayland
# Phone shell: device profile and install dir (read by its hyprland.lua).
export OPHONE_DEVICE="${OPHONE_DEVICE:-iphone6s}"
export OPHONE_SHELL="${OPHONE_SHELL:-/usr/share/omarchy-phone/shell}"
# The shell owns org.freedesktop.Notifications on the session bus.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
# aquamarine retries a (never available) EGL device renderer on every commit
# on simpledrm; the shim stops that (source: tools/userland/shim/aq-simpledrm.c).
shim="${PHONE_AQ_SHIM:-/usr/lib/phone-tk/aq-simpledrm.so}"
[ -r "$shim" ] && export LD_PRELOAD="$shim${LD_PRELOAD:+:$LD_PRELOAD}"
mkdir -p "$HOME/.cache"
bin=Hyprland
command -v start-hyprland >/dev/null 2>&1 && [ -z "${PHONE_NO_WATCHDOG:-}" ] && bin=start-hyprland
if [ "${1:-}" = "--fg" ]; then exec "$bin"; fi
nohup "$bin" >"$HOME/.cache/hyprland.log" 2>&1 </dev/null &
echo "started $bin (pid $!), log: $HOME/.cache/hyprland.log"
