index b89ef40df7f8..ec884578332d 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -334,6 +334,20 @@ config BATTERY_BQ27XXX_HDQ
 	  Say Y here to enable support for batteries with BQ27xxx chips
 	  connected over an HDQ bus.
 
+config BATTERY_BQ27XXX_HDQ_UART
+	tristate "BQ27xxx HDQ over UART support"
+	depends on BATTERY_BQ27XXX
+	depends on SERIAL_DEV_BUS
+	help
+	  Say Y here to enable support for batteries with BQ27xxx chips
+	  whose HDQ line is wired to both pins of a UART, as found in
+	  Apple iPhones. If the line is shared with another HDQ master
+	  through a switch, enable the multiplexer driver for that switch
+	  too (e.g. MUX_SN2400).
+
+	  To compile the driver as a module, choose M here: the module will
+	  be called bq27xxx_battery_hdq_uart.
+
 config BATTERY_BQ27XXX_DT_UPDATES_NVM
 	bool "BQ27xxx support for update of NVM/flash data memory"
 	depends on BATTERY_BQ27XXX_I2C
