From 4b6bfc0f032e85c93d172f07edeae52743574277 Mon Sep 17 00:00:00 2001
From: modpunk <27315771+modpunk@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:17:58 -0500
Subject: [PATCH 3/5] mux: Add SN2400 charger HDQ line switch

On Apple iPhones the fuel gauge's HDQ line runs through the SN2400
charger, which either talks to the gauge itself, connects the line to the
application processor, or leaves it disconnected. Register 0x1d selects
the owner and bit 5 acknowledges a host request.

Expose this as a three-state mux so the gauge driver can claim the line
for each access, as iOS does (AppleHDQGasGauge calls the charger's HDQm
platform function around every gauge transaction). While idle the line is
returned to whoever owned it at boot.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: modpunk <27315771+modpunk@users.noreply.github.com>
---
 drivers/mux/Kconfig  |  13 ++++
 drivers/mux/Makefile |   2 +
 drivers/mux/sn2400.c | 157 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 172 insertions(+)
 create mode 100644 drivers/mux/sn2400.c

diff --git a/drivers/mux/Kconfig b/drivers/mux/Kconfig
index 6d17dfa25dad..761630f8a7ef 100644
--- a/drivers/mux/Kconfig
+++ b/drivers/mux/Kconfig
@@ -70,6 +70,19 @@ config MUX_MMIO
 	  To compile the driver as a module, choose M here: the module will
 	  be called mux-mmio.
 
+config MUX_SN2400
+	tristate "SN2400 charger HDQ line switch"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  The SN2400 ("Tigris") charger in Apple iPhones sits between the
+	  battery fuel gauge and the application processor and decides who
+	  may talk HDQ to the gauge. This driver exposes that switch as a
+	  multiplexer so the fuel gauge driver can claim the line.
+
+	  To compile the driver as a module, choose M here: the module will
+	  be called mux-sn2400.
+
 endmenu
 
 endif # MULTIPLEXER
diff --git a/drivers/mux/Makefile b/drivers/mux/Makefile
index 6e9fa47daf56..2175be4d2e7b 100644
--- a/drivers/mux/Makefile
+++ b/drivers/mux/Makefile
@@ -8,9 +8,11 @@ mux-adg792a-objs		:= adg792a.o
 mux-adgs1408-objs		:= adgs1408.o
 mux-gpio-objs			:= gpio.o
 mux-mmio-objs			:= mmio.o
+mux-sn2400-objs			:= sn2400.o
 
 obj-$(CONFIG_MULTIPLEXER)	+= mux-core.o
 obj-$(CONFIG_MUX_ADG792A)	+= mux-adg792a.o
 obj-$(CONFIG_MUX_ADGS1408)	+= mux-adgs1408.o
 obj-$(CONFIG_MUX_GPIO)		+= mux-gpio.o
 obj-$(CONFIG_MUX_MMIO)		+= mux-mmio.o
+obj-$(CONFIG_MUX_SN2400)	+= mux-sn2400.o
diff --git a/drivers/mux/sn2400.c b/drivers/mux/sn2400.c
new file mode 100644
index 000000000000..03c9f21a598e
--- /dev/null
+++ b/drivers/mux/sn2400.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * HDQ line switch of the SN2400 ("Tigris") charger used in Apple iPhones
+ *
+ * On these phones the battery fuel gauge's HDQ line runs through the
+ * charger. The charger can talk to the gauge itself ("BMU master"), hand the
+ * line over to the host's HDQ UART, or leave it disconnected. Register 0x1d
+ * selects the owner; a host request is acknowledged by the charger setting
+ * bit 5. The sequence below follows what iOS does before and after every
+ * gauge access.
+ *
+ * Mux states:
+ *   0 - line disconnected
+ *   1 - line connected to the host (application processor UART)
+ *   2 - line owned by the charger's own gauge master
+ *
+ * Copyright (C) 2026 The Hoolock Linux contributors
+ */
+
+#include <linux/bits.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mux/driver.h>
+#include <linux/regmap.h>
+
+#define SN2400_REG_HDQ_CTRL	0x1d
+#define SN2400_HDQ_CHARGER	BIT(1)
+#define SN2400_HDQ_REQUEST	BIT(2)
+#define SN2400_HDQ_ACK		BIT(5)
+
+#define SN2400_HDQ_ACK_POLL_US		1000
+#define SN2400_HDQ_ACK_TIMEOUT_US	(1000 * USEC_PER_MSEC)
+
+enum {
+	SN2400_HDQ_STATE_NONE,
+	SN2400_HDQ_STATE_HOST,
+	SN2400_HDQ_STATE_CHARGER,
+	SN2400_HDQ_NUM_STATES,
+};
+
+static const struct regmap_config sn2400_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+};
+
+static int sn2400_hdq_request(struct regmap *map)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_write(map, SN2400_REG_HDQ_CTRL, SN2400_HDQ_REQUEST);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(map, SN2400_REG_HDQ_CTRL, val,
+				       val & SN2400_HDQ_ACK,
+				       SN2400_HDQ_ACK_POLL_US,
+				       SN2400_HDQ_ACK_TIMEOUT_US);
+	if (ret)
+		regmap_write(map, SN2400_REG_HDQ_CTRL, 0);
+
+	return ret;
+}
+
+static int __sn2400_mux_set(struct regmap *map, int state)
+{
+	int ret;
+
+	switch (state) {
+	case SN2400_HDQ_STATE_NONE:
+		return regmap_write(map, SN2400_REG_HDQ_CTRL, 0);
+	case SN2400_HDQ_STATE_HOST:
+		return sn2400_hdq_request(map);
+	case SN2400_HDQ_STATE_CHARGER:
+		ret = sn2400_hdq_request(map);
+		if (ret)
+			return ret;
+		return regmap_write(map, SN2400_REG_HDQ_CTRL,
+				    SN2400_HDQ_REQUEST | SN2400_HDQ_CHARGER);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int sn2400_mux_set(struct mux_control *mux, int state)
+{
+	struct device *dev = mux->chip->dev.parent;
+	struct regmap *map = dev_get_regmap(dev, NULL);
+	unsigned int val = 0;
+	int ret;
+
+	ret = __sn2400_mux_set(map, state);
+	regmap_read(map, SN2400_REG_HDQ_CTRL, &val);
+	dev_dbg(dev, "HDQ state %d: control now %#04x (%d)\n", state, val, ret);
+
+	return ret;
+}
+
+static const struct mux_control_ops sn2400_mux_ops = {
+	.set = sn2400_mux_set,
+};
+
+static int sn2400_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct mux_chip *mux_chip;
+	struct regmap *map;
+	unsigned int val;
+	int ret, idle;
+
+	map = devm_regmap_init_i2c(client, &sn2400_regmap_config);
+	if (IS_ERR(map))
+		return dev_err_probe(dev, PTR_ERR(map), "failed to init regmap\n");
+
+	ret = regmap_read(map, SN2400_REG_HDQ_CTRL, &val);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read HDQ control\n");
+
+	/* Return the line to whoever had it at boot while it is not in use */
+	if (val & SN2400_HDQ_CHARGER)
+		idle = SN2400_HDQ_STATE_CHARGER;
+	else if (val & SN2400_HDQ_REQUEST)
+		idle = SN2400_HDQ_STATE_HOST;
+	else
+		idle = SN2400_HDQ_STATE_NONE;
+
+	dev_info(dev, "HDQ control %#04x, idle state %d\n", val, idle);
+
+	mux_chip = devm_mux_chip_alloc(dev, 1, 0);
+	if (IS_ERR(mux_chip))
+		return PTR_ERR(mux_chip);
+
+	mux_chip->ops = &sn2400_mux_ops;
+	mux_chip->mux[0].states = SN2400_HDQ_NUM_STATES;
+	mux_chip->mux[0].idle_state = idle;
+
+	return devm_mux_chip_register(dev, mux_chip);
+}
+
+static const struct of_device_id sn2400_of_match[] = {
+	{ .compatible = "ti,sn2400" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sn2400_of_match);
+
+static struct i2c_driver sn2400_driver = {
+	.driver = {
+		.name = KBUILD_MODNAME,
+		.of_match_table = sn2400_of_match,
+	},
+	.probe = sn2400_probe,
+};
+module_i2c_driver(sn2400_driver);
+
+MODULE_DESCRIPTION("SN2400 charger HDQ line switch");
+MODULE_LICENSE("GPL");
-- 
