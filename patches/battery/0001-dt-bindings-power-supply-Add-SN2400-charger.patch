From 183f10640de142d423a822182f1eef231ff79b96 Mon Sep 17 00:00:00 2001
From: modpunk <27315771+modpunk@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:17:57 -0500
Subject: [PATCH 1/5] dt-bindings: power: supply: Add SN2400 charger

The SN2400 ("Tigris") charger in Apple iPhones sits between the battery
fuel gauge and the application processor and owns a switch in front of
the gauge's HDQ line. Describe the charger with that switch as a
mux-state provider; charging itself is not described yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: modpunk <27315771+modpunk@users.noreply.github.com>
---
 .../bindings/power/supply/ti,sn2400.yaml      | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml b/Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml
new file mode 100644
index 000000000000..856b6996ddba
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,sn2400.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SN2400 ("Tigris") battery charger
+
+maintainers:
+  - Sebastian Reichel <sre@kernel.org>
+
+description: |
+  Battery charger found in Apple iPhones (for example the iPhone 6s). It sits
+  between the battery fuel gauge and the application processor and owns a
+  switch in front of the gauge's HDQ line, exposed as a mux-state provider:
+
+    0 - HDQ line disconnected
+    1 - HDQ line connected to the application processor
+    2 - HDQ line driven by the charger's own gauge master
+
+  Only the HDQ switch is described so far.
+
+properties:
+  compatible:
+    const: ti,sn2400
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  '#mux-state-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - '#mux-state-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        charger: charger@75 {
+            compatible = "ti,sn2400";
+            reg = <0x75>;
+            #mux-state-cells = <1>;
+        };
+    };
-- 
