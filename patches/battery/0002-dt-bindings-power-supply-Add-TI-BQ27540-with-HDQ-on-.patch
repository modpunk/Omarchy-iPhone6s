From 4fe235624d65fa13b2a5b0104cd82ce1cbc9ac33 Mon Sep 17 00:00:00 2001
From: modpunk <27315771+modpunk@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:17:57 -0500
Subject: [PATCH 2/5] dt-bindings: power: supply: Add TI BQ27540 with HDQ on a
 UART

Some boards wire the single HDQ line of a bq27540 fuel gauge to both pins
of a UART and generate HDQ one UART character per bit. Describe such a
gauge as a serial device, with an optional mux-state for a switch in
front of the line.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: modpunk <27315771+modpunk@users.noreply.github.com>
---
 .../bindings/power/supply/ti,bq27540-hdq.yaml | 46 +++++++++++++++++++
 1 file changed, 46 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/ti,bq27540-hdq.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/ti,bq27540-hdq.yaml b/Documentation/devicetree/bindings/power/supply/ti,bq27540-hdq.yaml
new file mode 100644
index 000000000000..4cbaddef945d
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/ti,bq27540-hdq.yaml
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,bq27540-hdq.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TI BQ27540 fuel gauge with its HDQ line on a UART
+
+maintainers:
+  - Sebastian Reichel <sre@kernel.org>
+
+description:
+  The fuel gauge's single-wire HDQ interface is connected to both the TX and
+  the RX pin of a UART, and HDQ is generated one UART character per HDQ bit.
+  The node is a child of the UART. On Apple iPhones the line passes through
+  a switch in the charger, which is described with mux-states.
+
+allOf:
+  - $ref: power-supply.yaml#
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: ti,bq27540-hdq
+
+  mux-states:
+    description:
+      Switch state that connects the HDQ line to this UART. It is selected
+      for each register read and released afterwards.
+    maxItems: 1
+
+  monitored-battery: true
+
+required:
+  - compatible
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    serial {
+        fuel-gauge {
+            compatible = "ti,bq27540-hdq";
+            mux-states = <&charger 1>;
+        };
+    };
-- 
