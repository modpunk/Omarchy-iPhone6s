From 795464fdf2defbc6368776627cdc5a39b9e1c45b Mon Sep 17 00:00:00 2001
From: modpunk <27315771+modpunk@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:20:47 -0500
Subject: [PATCH 1/6] dt-bindings: gpio: Add Apple PMIC GPIO controller

Document the GPIO block of the Apple (Dialog) I2C PMICs and allow it as a
subdevice of apple,pmic.

Signed-off-by: modpunk <27315771+modpunk@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/gpio/apple,pmic-gpio.yaml        | 58 +++++++++++++++++++
 .../devicetree/bindings/mfd/apple,pmic.yaml   |  3 +
 2 files changed, 61 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml

diff --git a/Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml b/Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml
new file mode 100644
index 000000000000..16c543838e80
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/apple,pmic-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple PMIC GPIO controller
+
+maintainers:
+  - modpunk <27315771+modpunk@users.noreply.github.com>
+
+description: |
+  This module is part of Apple PMICs. For more details see
+  ../mfd/apple,pmic.yaml.
+
+  General purpose pins of the Dialog-designed PMICs used on Apple A7-A10X
+  SoCs. iOS uses them for, among other things, the Bluetooth and WLAN power
+  enable (REG_ON) lines, baseband power and several wake inputs. Pins are
+  numbered as in the "function-*" GPIO references of Apple's device tree
+  that point at the PMU node.
+
+properties:
+  compatible:
+    const: apple,antigua-pmic-gpio
+
+  reg:
+    maxItems: 1
+    description: Offset of the first pin configuration register.
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+
+  gpio-line-names:
+    maxItems: 17
+
+required:
+  - compatible
+  - reg
+  - gpio-controller
+  - "#gpio-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        gpio@900 {
+            compatible = "apple,antigua-pmic-gpio";
+            reg = <0x900>;
+            gpio-controller;
+            #gpio-cells = <2>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 8b2d325bc641..08f60f3c0113 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -62,6 +62,9 @@ patternProperties:
   "^backlight(@[0-9a-f]+)?$":
     $ref: /schemas/leds/backlight/apple,pmic-bl.yaml
 
+  "^gpio(@[0-9a-f]+)?$":
+    $ref: /schemas/gpio/apple,pmic-gpio.yaml
+
   "^rtc(@[0-9a-f]+)?$":
     $ref: /schemas/rtc/apple,pmic-rtc.yaml
 
-- 
