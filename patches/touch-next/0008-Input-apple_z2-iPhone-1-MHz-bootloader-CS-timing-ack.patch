+	/*
+	 * The bootloader needs the ADT chip select setup/hold times; they
+	 * were not applied when the DT (or an overlay applied after the SPI
+	 * device was created) did not carry spi-cs-*-delay-ns.
+	 */
+	if (z2->variant && z2->variant->hbpp) {
+		if (!spi->cs_setup.value && z2->variant->cs_setup_ns) {
+			spi->cs_setup.value = z2->variant->cs_setup_ns;
+			spi->cs_setup.unit = SPI_DELAY_UNIT_NSECS;
+		}
+		if (!spi->cs_hold.value && z2->variant->cs_hold_ns) {
+			spi->cs_hold.value = z2->variant->cs_hold_ns;
+			spi->cs_hold.unit = SPI_DELAY_UNIT_NSECS;
