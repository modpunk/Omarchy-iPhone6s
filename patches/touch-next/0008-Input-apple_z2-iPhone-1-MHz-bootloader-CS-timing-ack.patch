+
+/*
+ * HBPP DATA packet with the DT calibration, built in wire order:
+ * 30 01 | len/4 | addr lo, addr hi | header sum | payload | sum32 lo, hi.
+ * Same framing as the constructed firmware images (minus their leading NOP).
+ */
+static int apple_z2_hbpp_send_cal(struct apple_z2 *z2, u32 address)
+{
+	struct device *dev = &z2->spidev->dev;
+	size_t len, padded, pkt_len, i;
+	char what[48];
+	u32 sum = 0;
+	u8 *cal, *pkt;
+	int count, error;
+
+	if (!device_property_present(dev, CAL_PROP_NAME)) {
+		dev_warn(dev, "no %s, skipping calibration\n", CAL_PROP_NAME);
+		return 0;
+	}
+	count = device_property_count_u8(dev, CAL_PROP_NAME);
+	if (count <= 0)
+		return count ? count : -EINVAL;
+	len = count;
+	padded = round_up(len, 4);
+	pkt_len = APPLE_Z2_HBPP_DATA_HDR_LEN + padded + 4;
+
+	u8 *buf __free(kfree) = kzalloc(pkt_len + padded, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	pkt = buf;
+	cal = buf + pkt_len;
+	error = device_property_read_u8_array(dev, CAL_PROP_NAME, cal, len);
 	if (error)
 		return error;
-	if (status != APPLE_Z2_HBPP_ACK_DATA) {
-		dev_err(&z2->spidev->dev, "blob of %u bytes: ack 0x%04x\n",
-			size, status);
-		return -EIO;
+
+	put_unaligned_be16(APPLE_Z2_HBPP_CMD_BLOB, pkt);
+	put_unaligned_be16(padded / 4, pkt + 2);
+	apple_z2_put_hbpp32(pkt + 4, address);
+	put_unaligned_be16(apple_z2_sum8(pkt + 2, 6), pkt + 8);
+	for (i = 0; i < padded; i += 2) {
+		u8 *w = pkt + APPLE_Z2_HBPP_DATA_HDR_LEN + i;
+
+		w[0] = hbpp_cal_swap ? cal[i + 1] : cal[i];
+		w[1] = hbpp_cal_swap ? cal[i] : cal[i + 1];
+		sum += cal[i] + cal[i + 1];
 	}
-	return 0;
+	apple_z2_put_hbpp32(pkt + APPLE_Z2_HBPP_DATA_HDR_LEN + padded, sum);
+
+	snprintf(what, sizeof(what), "calibration %zu bytes to 0x%08x", pkt_len,
+		 address);
+	dev_dbg(dev, "%s: payload %zu, sum 0x%08x, swap %d\n", what, len, sum,
+		hbpp_cal_swap);
+	error = apple_z2_hbpp_xfer(z2, pkt, NULL, pkt_len, what);
+	if (error)
+		return error;
+
+	error = apple_z2_hbpp_wait_ack(z2, APPLE_Z2_HBPP_ACK_DATA, what);
+	if (!error)
+		dev_info(dev, "%s: acked\n", what);
+	return error;
 }
 
