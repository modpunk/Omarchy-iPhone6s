+			return dev_err_probe(dev, error, "spi setup\n");
+		dev_info(dev, "HBPP at %u Hz (run %u Hz), mode %u, CS setup %u hold %u ns\n",
+			 hbpp_speed_hz ? min(hbpp_speed_hz, spi->max_speed_hz) :
+			 spi->max_speed_hz, spi->max_speed_hz,
+			 (unsigned int)(spi->mode & SPI_MODE_X_MASK),
