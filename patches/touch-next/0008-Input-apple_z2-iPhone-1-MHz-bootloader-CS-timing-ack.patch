From 58239955d992887dfc94a16a3cbb6cea962cd61b Mon Sep 17 00:00:00 2001
From: kingmk3r <kingmk3r@katari.ai>
Date: Tue, 29 Sep 2026 20:45:37 -0500
Subject: [PATCH 8/8] Input: apple_z2: iPhone: 1 MHz bootloader, CS timing,
 acks and tracing

Fixes for the first run against a live iPhone 6s HBPP bootloader, where
the controller answered (1f01, 4879 ..., version 0x434d15c1 at
0x10008ffc) but the calibration packet was rejected:

- Build the calibration DATA packet directly in wire order with the
  10-byte header, the same framing as Apple's constructed firmware
  images (30 01 | len/4 | addr lo, hi | header sum | payload | sum32).
  The payload is swapped per 16-bit word by default, because the
  bootloader stores each big endian wire word little endian (the images
  carry ARM word e59ff018 as f0 18 e5 9f); hbpp_cal_swap=0 sends it as is.
- Run the bootloader phase at hbpp_speed_hz (default 1 MHz, the rate
  touch_diag_d2 verified); the DT spi-max-frequency is used after
  EXECUTE for the report reads.
- Apply the ADT chip select setup/hold times (5000/10000 ns) when the DT
  gives none. The booted DT and a later overlay don't set them, and the
  SPI core only parses them when the device is created.
- Send long packets as one message of 4 KiB transfers with CS held.
- Poll ATN (up to 50 times, 1 ms apart) while the bootloader still reads
  idle after a packet; any other status is final and is reported with
  its name.
- Check the memory read reply (status 0x4c39 and the value sum).
- dyndbg: every HBPP packet (head and tail of long ones), every status
  word and every report read. Milestones are logged at info level.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/apple_z2.c | 296 +++++++++++++++++++++++----
 1 file changed, 258 insertions(+), 38 deletions(-)

diff --git a/drivers/input/touchscreen/apple_z2.c b/drivers/input/touchscreen/apple_z2.c
index ab9fe0c77c1c..ac4f35d16a86 100644
--- a/drivers/input/touchscreen/apple_z2.c
+++ b/drivers/input/touchscreen/apple_z2.c
@@ -45,7 +45,34 @@
 #define APPLE_Z2_HBPP_EXECUTE            0x1d53
 #define APPLE_Z2_HBPP_ACK_DATA           0x4bc1
 #define APPLE_Z2_HBPP_ACK_REG            0x4ad1
+#define APPLE_Z2_HBPP_IDLE               0x4879
+#define APPLE_Z2_HBPP_READ_DATA          0x4c39
 #define APPLE_Z2_HBPP_PKT_LEN            16
+/* 0x3001, len/4, addr (two words), header sum: 10 bytes, no padding */
+#define APPLE_Z2_HBPP_DATA_HDR_LEN       10
+/* Largest single SPI transfer; longer packets are split with CS held */
+#define APPLE_Z2_HBPP_CHUNK              4096
+#define APPLE_Z2_HBPP_ACK_POLLS          50
+
+/*
+ * Bootloader phase SPI clock. The HBPP handshake is known to work at 1 MHz
+ * (touch_diag_d2 on N71); the DT spi-max-frequency (8 MHz, the ADT value) is
+ * used once the firmware runs. 0 means "use the DT speed for the bootloader
+ * too".
+ */
+static unsigned int hbpp_speed_hz = 1000000;
+module_param(hbpp_speed_hz, uint, 0644);
+MODULE_PARM_DESC(hbpp_speed_hz, "HBPP bootloader SPI clock in Hz (0: DT speed)");
+
+/*
+ * The bootloader stores every big endian 16-bit wire word little endian (the
+ * constructed firmware images carry ARM code as f0 18 e5 9f on the wire for
+ * the word e59ff018), so the calibration bytes are byte swapped per 16-bit
+ * word to land in memory in ADT order. Clear this to send them unswapped.
+ */
+static bool hbpp_cal_swap = true;
+module_param(hbpp_cal_swap, bool, 0644);
+MODULE_PARM_DESC(hbpp_cal_swap, "Swap calibration bytes per 16-bit word (default on)");
 
