@@ -281,17 +315,74 @@ static u16 apple_z2_sum8(const u8 *p, size_t len)
 	return sum;
 }
 
-static int apple_z2_hbpp_xfer(struct apple_z2 *z2, const void *tx, void *rx,
-			      size_t len)
+static const char *apple_z2_hbpp_name(u16 w)
 {
-	struct spi_transfer xfer = {
-		.tx_buf = tx,
-		.rx_buf = rx,
-		.len = len,
-		.bits_per_word = 8,
-	};
+	switch (w) {
+	case APPLE_Z2_HBPP_NOP:		return "NOP";
+	case APPLE_Z2_HBPP_ATN:		return "ATN";
+	case APPLE_Z2_HBPP_REQ_CAL:	return "REQ_CAL";
+	case APPLE_Z2_HBPP_IDLE:	return "idle";
+	case APPLE_Z2_HBPP_ACK_REG:	return "ACK_REG";
+	case APPLE_Z2_HBPP_ACK_DATA:	return "ACK_DATA";
+	case APPLE_Z2_HBPP_READ_DATA:	return "READ_DATA";
+	case 0x4f81:			return "reject";
+	default:			return "?";
+	}
+}
 
-	return spi_sync_transfer(z2->spidev, &xfer, 1);
+/* dyndbg: every HBPP packet, head and tail for long ones */
+static void apple_z2_hbpp_trace(struct apple_z2 *z2, const char *dir,
+				const char *what, const u8 *buf, size_t len)
+{
+	if (!buf)
+		return;
+	if (len <= 32)
+		dev_dbg(&z2->spidev->dev, "hbpp %s %s (%zu): %*ph\n",
+			dir, what, len, (int)len, buf);
+	else
+		dev_dbg(&z2->spidev->dev, "hbpp %s %s (%zu): %*ph ... %*ph\n",
+			dir, what, len, 24, buf, 8, buf + len - 8);
+}
+
+static int apple_z2_hbpp_xfer(struct apple_z2 *z2, const void *tx, void *rx,
+			      size_t len, const char *what)
+{
+	unsigned int n = DIV_ROUND_UP(len, APPLE_Z2_HBPP_CHUNK), i;
+	u32 hz = hbpp_speed_hz;
+	struct spi_transfer *xfers;
+	struct spi_message msg;
+	int error;
+
+	if (hz && z2->spidev->max_speed_hz && hz > z2->spidev->max_speed_hz)
+		hz = z2->spidev->max_speed_hz;
+
+	apple_z2_hbpp_trace(z2, "tx", what, tx, len);
+
+	xfers = kcalloc(n, sizeof(*xfers), GFP_KERNEL);
+	if (!xfers)
+		return -ENOMEM;
+
+	/* One message, so CS stays asserted over the whole packet */
+	spi_message_init(&msg);
+	for (i = 0; i < n; i++) {
+		size_t off = (size_t)i * APPLE_Z2_HBPP_CHUNK;
+
+		xfers[i].tx_buf = tx ? (const u8 *)tx + off : NULL;
+		xfers[i].rx_buf = rx ? (u8 *)rx + off : NULL;
+		xfers[i].len = min_t(size_t, len - off, APPLE_Z2_HBPP_CHUNK);
+		xfers[i].bits_per_word = 8;
+		xfers[i].speed_hz = hz;
+		spi_message_add_tail(&xfers[i], &msg);
+	}
+	error = spi_sync(z2->spidev, &msg);
+	kfree(xfers);
+	if (error) {
+		dev_err(&z2->spidev->dev, "hbpp %s: spi error %d\n", what, error);
+		return error;
+	}
+
+	apple_z2_hbpp_trace(z2, "rx", what, rx, len);
+	return 0;
 }
 
 /* Send ATN and return the status word the bootloader answers with */
@@ -300,19 +391,52 @@ static int apple_z2_hbpp_ack(struct apple_z2 *z2, u16 *status)
 	int error;
 
 	put_unaligned_be16(APPLE_Z2_HBPP_ATN, z2->tx_buf);
-	error = apple_z2_hbpp_xfer(z2, z2->tx_buf, z2->rx_buf, 2);
+	error = apple_z2_hbpp_xfer(z2, z2->tx_buf, z2->rx_buf, 2, "ATN");
 	if (!error)
 		*status = get_unaligned_be16(z2->rx_buf);
 	return error;
 }
 
+/*
+ * Wait for the status of the last packet. The bootloader has to checksum
+ * (and store) the payload first, so an ATN right behind a long packet can
+ * still see the idle word; poll a few times before giving up. Any other
+ * status is final.
+ */
+static int apple_z2_hbpp_wait_ack(struct apple_z2 *z2, u16 expected,
+				  const char *what)
+{
+	struct device *dev = &z2->spidev->dev;
+	u16 status = 0;
+	int i, error;
+
+	for (i = 0; i < APPLE_Z2_HBPP_ACK_POLLS; i++) {
+		error = apple_z2_hbpp_ack(z2, &status);
+		if (error)
+			return error;
+		dev_dbg(dev, "hbpp %s: status 0x%04x (%s), poll %d\n", what,
+			status, apple_z2_hbpp_name(status), i);
+		if (status == expected)
+			return 0;
+		if (status != APPLE_Z2_HBPP_IDLE && status != APPLE_Z2_HBPP_NOP &&
+		    status != 0x0000 && status != 0xffff) {
+			i++;
+			break;
+		}
+		usleep_range(1000, 1500);
+	}
+	dev_err(dev, "%s: ack 0x%04x (%s) after %d polls, want 0x%04x\n",
+		what, status, apple_z2_hbpp_name(status), i, expected);
+	return -EIO;
+}
+
 static bool apple_z2_is_hbpp_word(u16 w)
 {
 	switch (w) {
 	case APPLE_Z2_HBPP_NOP:
 	case APPLE_Z2_HBPP_ATN:
 	case APPLE_Z2_HBPP_REQ_CAL:
-	case 0x4879:
+	case APPLE_Z2_HBPP_IDLE:
 	case 0x4969:
 	case APPLE_Z2_HBPP_ACK_REG:
 	case APPLE_Z2_HBPP_ACK_DATA:
@@ -332,7 +456,8 @@ static int apple_z2_hbpp_probe(struct apple_z2 *z2, bool *in_hbpp)
 	for (i = 2; i < APPLE_Z2_HBPP_PKT_LEN; i += 2)
 		put_unaligned_be16(APPLE_Z2_HBPP_NOP, z2->tx_buf + i);
 
-	error = apple_z2_hbpp_xfer(z2, z2->tx_buf, rx, APPLE_Z2_HBPP_PKT_LEN);
+	error = apple_z2_hbpp_xfer(z2, z2->tx_buf, rx, APPLE_Z2_HBPP_PKT_LEN,
+				   in_hbpp ? "check" : "park");
 	if (error)
 		return error;
 
@@ -342,40 +467,49 @@ static int apple_z2_hbpp_probe(struct apple_z2 *z2, bool *in_hbpp)
 		if (!*in_hbpp)
 			dev_err(&z2->spidev->dev, "no HBPP response: %*ph\n",
 				APPLE_Z2_HBPP_PKT_LEN, rx);
+		else
+			dev_info(&z2->spidev->dev, "HBPP bootloader: %*ph\n",
+				 APPLE_Z2_HBPP_PKT_LEN, rx);
 	}
 	return 0;
 }
 
 static int apple_z2_hbpp_read_reg(struct apple_z2 *z2, u32 addr, u32 *val)
 {
+	struct device *dev = &z2->spidev->dev;
 	u8 *rx = z2->rx_buf;
 	u8 *p = z2->tx_buf;
+	u16 status, sum;
 	int error;
 
 	put_unaligned_be16(APPLE_Z2_HBPP_MEM_READ, p);
 	apple_z2_put_hbpp32(p + 2, addr);
 	put_unaligned_be16(apple_z2_sum8(p + 2, 4), p + 6);
-	error = apple_z2_hbpp_xfer(z2, p, NULL, 8);
+	error = apple_z2_hbpp_xfer(z2, p, NULL, 8, "MEM_READ");
 	if (error)
 		return error;
 
-	/* Long ATN: the value comes back in words 1 and 2 */
+	/* Long ATN: status 0x4c39, the value in words 1 and 2, then its sum */
 	put_unaligned_be16(APPLE_Z2_HBPP_ATN, p);
 	put_unaligned_be16(APPLE_Z2_HBPP_NOP, p + 2);
 	put_unaligned_be16(APPLE_Z2_HBPP_NOP, p + 4);
 	put_unaligned_be16(APPLE_Z2_HBPP_NOP, p + 6);
-	error = apple_z2_hbpp_xfer(z2, p, rx, 8);
+	error = apple_z2_hbpp_xfer(z2, p, rx, 8, "MEM_READ reply");
 	if (error)
 		return error;
 
+	status = get_unaligned_be16(rx);
+	sum = get_unaligned_be16(rx + 6);
 	*val = get_unaligned_be16(rx + 2) | (get_unaligned_be16(rx + 4) << 16);
+	if (status != APPLE_Z2_HBPP_READ_DATA || sum != apple_z2_sum8(rx + 2, 4))
+		dev_warn(dev, "read 0x%08x: unexpected reply %*ph\n", addr, 8, rx);
 	return 0;
 }
 
