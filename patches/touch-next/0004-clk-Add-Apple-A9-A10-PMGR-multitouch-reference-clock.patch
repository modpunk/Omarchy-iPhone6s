From b77fb9e89bd7d23c626b3fe5920774d0473b438b Mon Sep 17 00:00:00 2001
From: modpunk <27315771+modpunk@users.noreply.github.com>
Date: Tue, 29 Sep 2026 20:01:30 -0500
Subject: [PATCH 4/8] clk: Add Apple A9/A10 PMGR multitouch reference clock

The Apple DT of the iPhone 6s asks for a 32768 Hz clock before the touch
controller is started (multi-touch function-clock_enable = TCLK
8/100/0x8000, where entry 8 of the PMGR "clocks" table is "LPO"), and the
controller's own boot sequence enables a "clk32" input. Linux never turns
it on.

On A10 the output is one PMGR register at +0x78000 (Corellium's GPL
clk-hx-pmgr.c): bit 31 disable, bit 19 enable, bit 18 busy, bits 9:0
divider from 24 MHz. Add a driver for that layout, as a child of the PMGR
syscon, plus its binding. The A9 offset is not confirmed yet, so the
driver refuses a register with bits outside the known fields and uses
CLK_IGNORE_UNUSED so unused-clock cleanup never writes it; the DT node
stays disabled.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/arm/apple/apple,pmgr.yaml        |   6 +
 .../clock/apple,s8000-touch-clock.yaml        |  62 ++++++
 drivers/clk/Kconfig                           |   8 +
 drivers/clk/Makefile                          |   1 +
 drivers/clk/clk-apple-touch.c                 | 186 ++++++++++++++++++
 5 files changed, 263 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/apple,s8000-touch-clock.yaml
 create mode 100644 drivers/clk/clk-apple-touch.c

diff --git a/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml b/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
index 1d2001836eb4..7728fcfc0fcc 100644
--- a/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
+++ b/Documentation/devicetree/bindings/arm/apple/apple,pmgr.yaml
@@ -61,6 +61,12 @@ patternProperties:
     type: object
     $ref: /schemas/power/apple,pmgr-pwrstate.yaml#
 
+  "^clock-controller@[0-9a-f]+$":
+    description:
+      Multitouch reference clock output
+    type: object
+    $ref: /schemas/clock/apple,s8000-touch-clock.yaml#
+
 required:
   - compatible
   - reg
diff --git a/Documentation/devicetree/bindings/clock/apple,s8000-touch-clock.yaml b/Documentation/devicetree/bindings/clock/apple,s8000-touch-clock.yaml
new file mode 100644
index 000000000000..545adea09e9c
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/apple,s8000-touch-clock.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/apple,s8000-touch-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A9 PMGR multitouch reference clock
+
+maintainers:
+  - modpunk <27315771+modpunk@users.noreply.github.com>
+
+description:
+  The 32.768 kHz reference the PMGR of Apple A9/A10 SoCs feeds to the
+  iPhone multitouch controller, divided from the 24 MHz reference. It is
+  one register inside the PMGR and is described as a child of the PMGR
+  syscon node.
+
+properties:
+  compatible:
+    const: apple,s8000-touch-clock
+
+  reg:
+    maxItems: 1
+    description: Offset of the clock register inside the PMGR
+
+  clocks:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 0
+
+  clock-frequency:
+    description: Output rate
+
+  clock-output-names:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - "#clock-cells"
+  - clock-frequency
+
+additionalProperties: false
+
+examples:
+  - |
+    power-management@20e000000 {
+        compatible = "apple,s8000-pmgr", "apple,pmgr", "syscon", "simple-mfd";
+        #address-cells = <1>;
+        #size-cells = <1>;
+        reg = <0xe000000 0x8c000>;
+
+        clock-controller@78000 {
+            compatible = "apple,s8000-touch-clock";
+            reg = <0x78000 0x8>;
+            #clock-cells = <0>;
+            clocks = <&clkref>;
+            clock-frequency = <32768>;
+        };
+    };
diff --git a/drivers/clk/Kconfig b/drivers/clk/Kconfig
index f9592fd9ec2b..1cdc3575a1a3 100644
--- a/drivers/clk/Kconfig
+++ b/drivers/clk/Kconfig
@@ -66,6 +66,14 @@ config COMMON_CLK_APPLE_NCO
 	  found on Apple SoCs such as t8103 (M1). The blocks are typically
 	  generators of audio clocks.
 
+config COMMON_CLK_APPLE_TOUCH
+	tristate "Apple A9/A10 multitouch reference clock"
+	depends on ARCH_APPLE || COMPILE_TEST
+	help
+	  The 32.768 kHz reference clock the PMGR of Apple A9/A10 SoCs
+	  feeds to the iPhone multitouch controller. Say M or Y for the
+	  iPhone 6s touchscreen.
+
 config COMMON_CLK_MAX77686
 	tristate "Clock driver for Maxim 77620/77686/77802 MFD"
 	depends on MFD_MAX77686 || MFD_MAX77620 || COMPILE_TEST
diff --git a/drivers/clk/Makefile b/drivers/clk/Makefile
index b18af485d7f0..0e32a734d4bd 100644
--- a/drivers/clk/Makefile
+++ b/drivers/clk/Makefile
@@ -56,6 +56,7 @@ endif
 # hardware specific clock types
 # please keep this section sorted lexicographically by file path name
 obj-$(CONFIG_COMMON_CLK_APPLE_NCO)  	+= clk-apple-nco.o
+obj-$(CONFIG_COMMON_CLK_APPLE_TOUCH)	+= clk-apple-touch.o
 obj-$(CONFIG_MACH_ASM9260)		+= clk-asm9260.o
 obj-$(CONFIG_COMMON_CLK_AXI_CLKGEN)	+= clk-axi-clkgen.o
 obj-$(CONFIG_ARCH_AXXIA)		+= clk-axm5516.o
diff --git a/drivers/clk/clk-apple-touch.c b/drivers/clk/clk-apple-touch.c
new file mode 100644
index 000000000000..d0406c1f5b63
--- /dev/null
+++ b/drivers/clk/clk-apple-touch.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple A9/A10 PMGR multitouch reference clock (32.768 kHz)
+ *
+ * The multitouch controller on these phones needs a 32 kHz reference from
+ * the SoC (Apple DT: "function-clock_enable" = TCLK, 32768 Hz; the
+ * controller's own boot sequence enables a "clk32" input). The PMGR output
+ * is a single register:
+ *
+ *   bit 31     DISABLE
+ *   bit 19     ENABLE
+ *   bit 18     BUSY (divider change in progress)
+ *   bits 9:0   divider from the parent (24 MHz reference)
+ *
+ * This layout is the one Corellium's GPL "hx,pmgr-clk-touch" driver uses
+ * on A10 (PMGR + 0x78000). It has not been confirmed on A9 hardware, so
+ * the register offset comes only from the device tree and the driver
+ * refuses to touch a register whose value does not look like this layout.
+ * The node is a child of the PMGR syscon and uses its regmap.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#define TOUCH_CLK_DISABLE	BIT(31)
+#define TOUCH_CLK_ENABLE	BIT(19)
+#define TOUCH_CLK_BUSY		BIT(18)
+#define TOUCH_CLK_DIV		GENMASK(9, 0)
+/* Bits the driver knows about; anything else set means "not this layout" */
+#define TOUCH_CLK_KNOWN		(TOUCH_CLK_DISABLE | TOUCH_CLK_ENABLE | \
+				 TOUCH_CLK_BUSY | TOUCH_CLK_DIV)
+
+struct apple_touch_clk {
+	struct clk_hw hw;
+	struct regmap *map;
+	u32 reg;
+	u32 rate;
+};
+
+#define to_apple_touch_clk(_hw) container_of(_hw, struct apple_touch_clk, hw)
+
+static u32 apple_touch_clk_div(struct apple_touch_clk *tc, unsigned long parent)
+{
+	return clamp_t(u32, DIV_ROUND_CLOSEST(parent, tc->rate), 1,
+		       FIELD_MAX(TOUCH_CLK_DIV));
+}
+
+static int apple_touch_clk_enable(struct clk_hw *hw)
+{
+	struct apple_touch_clk *tc = to_apple_touch_clk(hw);
+	unsigned long parent = clk_hw_get_rate(clk_hw_get_parent(hw));
+	u32 val;
+	int ret;
+
+	if (DIV_ROUND_CLOSEST(parent, tc->rate) > FIELD_MAX(TOUCH_CLK_DIV))
+		return -EINVAL;
+
+	ret = regmap_read(tc->map, tc->reg, &val);
+	if (ret)
+		return ret;
+	val &= ~TOUCH_CLK_DISABLE;
+	regmap_write(tc->map, tc->reg, val);
+
+	val &= ~TOUCH_CLK_DIV;
+	val |= TOUCH_CLK_ENABLE |
+	       FIELD_PREP(TOUCH_CLK_DIV, apple_touch_clk_div(tc, parent));
+	regmap_write(tc->map, tc->reg, val);
+
+	return regmap_read_poll_timeout_atomic(tc->map, tc->reg, val,
+					       !(val & TOUCH_CLK_BUSY), 10, 50000);
+}
+
+static void apple_touch_clk_disable(struct clk_hw *hw)
+{
+	struct apple_touch_clk *tc = to_apple_touch_clk(hw);
+	u32 val;
+
+	regmap_clear_bits(tc->map, tc->reg, TOUCH_CLK_ENABLE);
+	regmap_read_poll_timeout_atomic(tc->map, tc->reg, val,
+					!(val & TOUCH_CLK_BUSY), 10, 50000);
+	regmap_set_bits(tc->map, tc->reg, TOUCH_CLK_DISABLE);
+}
+
+static int apple_touch_clk_is_enabled(struct clk_hw *hw)
+{
+	struct apple_touch_clk *tc = to_apple_touch_clk(hw);
+	u32 val;
+
+	if (regmap_read(tc->map, tc->reg, &val))
+		return 0;
+	return (val & TOUCH_CLK_ENABLE) && !(val & TOUCH_CLK_DISABLE);
+}
+
+static unsigned long apple_touch_clk_recalc_rate(struct clk_hw *hw,
+						 unsigned long parent)
+{
+	struct apple_touch_clk *tc = to_apple_touch_clk(hw);
+	u32 val = 0, div;
+
+	regmap_read(tc->map, tc->reg, &val);
+	div = FIELD_GET(TOUCH_CLK_DIV, val);
+
+	/* Not programmed yet: report the rate enable() will set up */
+	if (!div)
+		div = apple_touch_clk_div(tc, parent);
+	return parent / div;
+}
+
+static const struct clk_ops apple_touch_clk_ops = {
+	.enable = apple_touch_clk_enable,
+	.disable = apple_touch_clk_disable,
+	.is_enabled = apple_touch_clk_is_enabled,
+	.recalc_rate = apple_touch_clk_recalc_rate,
+};
+
+static int apple_touch_clk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_parent_data parent = { .index = 0 };
+	struct clk_init_data init = {};
+	struct apple_touch_clk *tc;
+	u32 val;
+	int ret;
+
+	tc = devm_kzalloc(dev, sizeof(*tc), GFP_KERNEL);
+	if (!tc)
+		return -ENOMEM;
+
+	tc->map = syscon_node_to_regmap(dev->of_node->parent);
+	if (IS_ERR(tc->map))
+		return dev_err_probe(dev, PTR_ERR(tc->map), "no PMGR regmap\n");
+	if (of_property_read_u32_index(dev->of_node, "reg", 0, &tc->reg))
+		return dev_err_probe(dev, -EINVAL, "missing reg\n");
+
+	if (of_property_read_u32(dev->of_node, "clock-frequency", &tc->rate) ||
+	    !tc->rate)
+		return dev_err_probe(dev, -EINVAL, "no clock-frequency\n");
+
+	ret = regmap_read(tc->map, tc->reg, &val);
+	if (ret)
+		return ret;
+	dev_info(dev, "touch clock register 0x%08x\n", val);
+	if (val & ~TOUCH_CLK_KNOWN)
+		return dev_err_probe(dev, -ENODEV,
+				     "0x%08x does not look like a touch clock register\n",
+				     val);
+
+	init.name = dev->of_node->name;
+	of_property_read_string(dev->of_node, "clock-output-names", &init.name);
+	init.ops = &apple_touch_clk_ops;
+	/* Only a consumer (the touchscreen) may switch it, never unused-clock cleanup */
+	init.flags = CLK_IGNORE_UNUSED;
+	init.parent_data = &parent;
+	init.num_parents = 1;
+	tc->hw.init = &init;
+
+	ret = devm_clk_hw_register(dev, &tc->hw);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &tc->hw);
+}
+
+static const struct of_device_id apple_touch_clk_of_match[] = {
+	{ .compatible = "apple,s8000-touch-clock" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, apple_touch_clk_of_match);
+
+static struct platform_driver apple_touch_clk_driver = {
+	.driver = {
+		.name = "apple-touch-clk",
+		.of_match_table = apple_touch_clk_of_match,
+	},
+	.probe = apple_touch_clk_probe,
+};
+module_platform_driver(apple_touch_clk_driver);
+
+MODULE_DESCRIPTION("Apple A9/A10 PMGR multitouch reference clock");
+MODULE_LICENSE("GPL");
-- 
