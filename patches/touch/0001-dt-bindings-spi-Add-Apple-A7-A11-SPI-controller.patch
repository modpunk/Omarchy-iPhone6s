From 703f57b6507ffecface1dbb755a3959baaf7b881 Mon Sep 17 00:00:00 2001
From: modpunk <27315771+modpunk@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:23:42 -0500
Subject: [PATCH 1/6] dt-bindings: spi: Add Apple A7-A11 SPI controller

Document the SPI controller revision found on the pre-M1 Apple SoCs
("spi-1,samsung", spi-version 1 in the Apple device tree). It shares the
first register block with apple,spi but has a different FIFO/interrupt
layout, so it gets its own binding.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: modpunk <27315771+modpunk@users.noreply.github.com>
---
 .../bindings/spi/apple,s5l-spi.yaml           | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/spi/apple,s5l-spi.yaml

diff --git a/Documentation/devicetree/bindings/spi/apple,s5l-spi.yaml b/Documentation/devicetree/bindings/spi/apple,s5l-spi.yaml
new file mode 100644
index 000000000000..49fbc22f1a42
--- /dev/null
+++ b/Documentation/devicetree/bindings/spi/apple,s5l-spi.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/spi/apple,s5l-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A7-A11 (S5L-style) SPI controller
+
+description:
+  The SPI controller revision found on Apple A7 to A11 SoCs. It shares the
+  first register block with the M1-era controller (apple,spi) but keeps the
+  FIFO levels in the status register and has no FIFO/IRQ block at 0x10c+.
+
+allOf:
+  - $ref: spi-controller.yaml#
+
+maintainers:
+  - modpunk <27315771+modpunk@users.noreply.github.com>
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,s8000-spi
+      - const: apple,s5l-spi
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+      #address-cells = <2>;
+      #size-cells = <2>;
+
+      spi@20a088000 {
+        compatible = "apple,s8000-spi", "apple,s5l-spi";
+        reg = <0x2 0x0a088000 0x0 0x4000>;
+        interrupts = <AIC_IRQ 190 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&clkref>;
+        power-domains = <&ps_spi2>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+      };
+    };
+...
-- 
